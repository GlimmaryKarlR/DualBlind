# Gemini API Keys for server-side generation.
# Use one primary key, a comma-separated list, or numbered keys for automatic rotation.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Server Port (default: 3000)
PORT=3000

# Optional custom OrcaRouter endpoint
ORCAROUTER_BASE_URL=

# OpenRouter API Keys for local usage checks and automatic rotation.
# Use one primary key, a comma-separated list, or numbered keys for automatic rotation.
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Optional Hugging Face Token(s) for serverless inference router and dataset push
# Supports HF_TOKEN, HF_TOKENS (comma-separated), or HUGGINGFACE_API_KEY
HF_TOKEN=
HF_TOKENS=
HUGGINGFACE_API_KEY=
